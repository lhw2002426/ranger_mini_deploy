# Robonix VLM credentials (required by `system.pilot.vlm` in robonix_manifest.yaml).
#
# Usage:
#   cp .env.example .env
#   # fill in real values below
#   set -a; source .env; set +a
#   rbnx boot
#
# The .env file is gitignored; only this template is committed.
# Real credentials live with wheatfox / lab admin — DO NOT commit them.

# Base URL of an OpenAI-compatible chat-completion endpoint.
# Examples:
#   https://api.openai.com/v1
#   https://api.ofox.ai/v1
export VLM_BASE_URL=https://api.ofox.ai/v1

# Bearer token for the above endpoint. Format: sk-... (provider-dependent).
export VLM_API_KEY=sk-replace-me

# Model id served by VLM_BASE_URL. Must support function-calling /
# tool-use (pilot streams tool_calls; non-tool-capable models will hang).
export VLM_MODEL=gpt-5.4-mini
